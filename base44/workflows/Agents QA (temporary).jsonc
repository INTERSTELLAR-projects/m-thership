{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "one_time",
      "cron_expression": null,
      "one_time_date": "2027-12-31T08:00:00Z",
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Agents QA (temporary)",
  "description": "Temporary QA run for the Agent Constellation (CEO chat, client CEO chat, brain edit / finding / refine). Archived after testing.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "agents_qa_temporary",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "chat_hq": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "agents",
            "args": {
              "action": "ceo_chat",
              "scope": "interstellar",
              "ceo_name": "Commander",
              "messages": [
                {
                  "role": "user",
                  "content": "What needs my approval right now, what's broken, and which clients need attention?"
                }
              ]
            }
          },
          "then": "chat_client"
        }
      },
      {
        "chat_client": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "agents",
            "args": {
              "action": "ceo_chat",
              "scope": "client",
              "client_id": "69d884d3501897bd1df0794c",
              "client_name": "Mow Masters of Ascension",
              "messages": [
                {
                  "role": "user",
                  "content": "What are this client's agents doing, and what's waiting on me?"
                }
              ]
            }
          },
          "then": "edit_hq"
        }
      },
      {
        "edit_hq": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "agents",
            "args": {
              "action": "brain_edit",
              "brain_id": "6aeb8940f6f5354c7acbbb70",
              "section": "competitors",
              "text": "No named agency competitors are on record yet. Open question for Justin: which agencies do prospects compare Interstellar to?",
              "confidence": "low"
            }
          },
          "then": "finding_cg"
        }
      },
      {
        "finding_cg": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "agents",
            "args": {
              "action": "brain_add_update",
              "brain_id": "6aeb88eccdbffed92977b42d",
              "section": "contacts_channels",
              "text": "Instagram handle is @chaseandgains.",
              "source": "CRMClient / client summary (QA duplicate check)",
              "by": "agent",
              "agent_key": "client_research:69d884d3dd31b39b6a77c7cd"
            }
          },
          "then": "refine_cg"
        }
      },
      {
        "refine_cg": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "agents",
            "args": {
              "action": "brain_refine",
              "brain_id": "6aeb88eccdbffed92977b42d"
            }
          },
          "then": "refine_hq"
        }
      },
      {
        "refine_hq": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "agents",
            "args": {
              "action": "brain_refine",
              "brain_id": "6aeb8940f6f5354c7acbbb70"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}