{
  "name": "Social Studio — publish approved posts",
  "description": "OFF since Nov 19, 2026 (Justin): approving only marks a post ready and Justin posts it himself; keep inactive. Was: every 15 minutes: publishes Social Studio posts Justin approved whose scheduled time has passed, to Instagram (and the Facebook Page when that toggle is on). Drafts, declined and unapproved posts are never touched.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": { "dsl": "1.0.0", "name": "social_publish_due", "version": "1.0", "namespace": "base44" },
    "do": [
      {
        "publish_due": {
          "call": "invoke_backend_function",
          "with": { "function_name": "social-publish", "args": { "action": "run_due" } },
          "then": "end",
          "x-base44": { "title": "Publish due posts", "description": "Approved + scheduled_at passed" }
        }
      }
    ]
  }
}
