{
  "name": "Agents \u2014 nightly brain refresh",
  "description": "Nightly: seeds any missing Business Brain from M\u00f8thership records, rebuilds every active client's agent instances from real data, and refines up to 5 brains (merges agent/research findings, flags conflicts for Justin, rewrites the at-a-glance summary). Steps 2-15 (brain-to-dossier, in chunks so no call hits the time limit): maps changed Brains into each ClientDossier, mirrors finished work and brand kits for the Constellations web, re-scores every client and rebuilds the shared client context block agents read. Records only: never sends anything to a client and never changes a client site, package or price.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "13 22 * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "agents_nightly_brain_refresh",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "nightly": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "agents",
            "args": {
              "action": "nightly"
            }
          },
          "then": "brain_to_dossier",
          "x-base44": {
            "title": "Seed, sync and refine brains",
            "description": "Business Brains + client agent instances"
          }
        }
      },
      {
        "brain_to_dossier": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "brain-to-dossier",
            "args": {
              "action": "nightly"
            }
          },
          "then": "brain_to_dossier_2",
          "x-base44": {
            "title": "Brain \u2192 dossier sync (chunk 1 of 14)",
            "description": "Continues tonight's pass: maps changed Brains into ClientDossier, mirrors work + brand kits, re-scores Constellations, rebuilds context blocks. Does nothing once the pass is complete."
          }
        }
      },
      {
        "brain_to_dossier_2": {
