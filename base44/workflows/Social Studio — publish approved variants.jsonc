{
  "name": "Social Studio — publish approved variants",
  "description": "Every 15 minutes: posts content-engine variants Justin approved whose time has passed, on auto-mode accounts only (connector or secret in place). Manual platforms, drafts, declined and unapproved variants are never touched.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "social_channels_publish_due",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "publish_due": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "social-channels",
            "args": {
              "action": "run_due"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Publish due variants",
            "description": "Approved + scheduled_at passed + auto mode"
          }
        }
      }
    ]
  }
}