{
  "name": "Work ledger \u2014 hourly sync",
  "description": "Hourly at :23: turns finished work (Road to Dec 31 items, Claude queue jobs, agent and workflow runs, published work, completed requests, engine starts) into Work ledger rows for Output and the client portal 'Work we did' feed, and fills time-saved estimates and client-safe copy for rows Claude logged. Records only: never sends, publishes or changes a client site. Function: work-ledger / sync.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "23 * * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "work_ledger_hourly_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "work-ledger",
            "args": {
              "action": "sync"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}