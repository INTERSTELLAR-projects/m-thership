            }
          },
          "then": "seed_2",
          "x-base44": {
            "title": "Draft foundation prompts (batch 1 of 36)",
            "description": "Drafts up to 3 prompts (generic v1 for empty areas first, then industry versions). Does nothing once the seed is complete."
          }
