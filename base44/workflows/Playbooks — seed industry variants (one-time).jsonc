{
  "name": "Playbooks \u2014 seed industry variants (one-time)",
  "description": "Manual helper (kept inactive; use Run now): drafts a generic v1 for every Playbooks area without a prompt, then an industry version of all 12 areas for 7 industries, 3 at a time. Everything is status draft and waits in the Playbooks Approve queue; nothing is approved. The function refuses once the seed is complete. Function: promptAgent / seed_variants.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 1 1 *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
