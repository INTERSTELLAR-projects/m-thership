{
  "name": "Brain \u2192 dossier \u2014 queued run",
  "description": "Manual helper (kept inactive; use Run now): runs brain-to-dossier for the clients an admin queued in AppSettings brain_to_dossier_queue in the last hour, one chunk per step (16 steps). Steps do nothing once the queue is empty. Records only: never sends, publishes or switches anything on.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 1 1 *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
