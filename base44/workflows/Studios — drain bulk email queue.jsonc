{
  "name": "Studios \u2014 drain bulk email queue",
  "description": "Every 5 minutes (email-drain): releases scheduled Email Studio campaigns whose time has come, sends the next queued batches through Amazon SES (rate-limited, one email per recipient, suppression + unsubscribe + open/click tracking), and runs Email Studio automations (welcome, review request, win-back, birthday/anniversary). Does nothing when nothing is due; real sends wait until SES is configured (test clients run in dry-run mode).",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {
              "action": "drain"
            },
            "function_name": "email-drain"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "studios_drain_bulk_email",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}