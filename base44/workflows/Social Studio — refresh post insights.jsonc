{
  "name": "Social Studio — refresh post insights",
  "description": "Daily: pulls likes, comments, reach and views for posted Social Studio items (last 90 days) from Instagram and the Facebook Page.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "41 6 * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": { "dsl": "1.0.0", "name": "social_refresh_insights", "version": "1.0", "namespace": "base44" },
    "do": [
      {
        "refresh_insights": {
          "call": "invoke_backend_function",
          "with": { "function_name": "social-publish", "args": { "action": "refresh_insights" } },
          "then": "end",
          "x-base44": { "title": "Refresh insights", "description": "Likes, comments, reach" }
        }
      }
    ]
  }
}
