    },
    "memberName": {
      "type": "string"
    },
    "referredClientName": {
      "type": "string"
    },
    "package": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Confirmed",
        "Paid Out"
      ],
      "default": "Pending"
    },
