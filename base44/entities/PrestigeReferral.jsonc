{
  "name": "PrestigeReferral",
  "type": "object",
  "properties": {
    "memberId": {
      "type": "string"
    },
    "memberName": {
      "type": "string"
    },
    "referredClientName": {
      "type": "string"
    },
    "package": {
      "type": "string"
    },
    "lineItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "service": {
            "type": "string"
          },
          "subscription": {
            "type": "boolean",
            "default": false
          },
          "amount": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Booked",
        "Confirmed",
        "Paid Out",
        "Lost"
      ],
      "default": "Pending"
    },
    "notes": {
      "type": "string"
    },
    "booked_at": {
      "type": "string",
      "description": "When the referral booked a call"
    },
    "signed_at": {
      "type": "string",
      "description": "When the referral signed (status Confirmed)"
    }
  },
  "required": [
    "memberId",
    "memberName",
    "referredClientName",
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}