{
  "name": "SocialPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Internal name for the post (not shown on the image)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "publishing",
        "posted",
        "failed",
        "declined"
      ],
      "default": "draft",
      "description": "draft -> approved (scheduled, Justin approved) -> publishing (publisher lock) -> posted | failed. declined = Justin said no. Nothing publishes unless Justin approved it."
    },
    "folder": {
      "type": "string",
      "description": "Free-text folder, e.g. 'Week of 2026-11-09'. The folder list is the union of folders used by posts and AppSettings key social_studio.pageSettings.folders"
    },
    "pillar": {
      "type": "string",
      "enum": [
        "pain_point",
        "product_showcase",
        "proof_of_process",
        "education",
        "offer",
        "founder_story"
      ]
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "instagram",
          "facebook",
          "linkedin",
          "x",
          "tiktok"
        ]
      },
      "description": "Platform targets"
    },
    "template": {
      "type": "string",
      "description": "Template key from src/features/social/templates.schema.json"
    },
    "spec": {
      "type": "object",
      "additionalProperties": true,
      "description": "Structured post spec rendered by the template: eyebrow, headline, accent_word, subhead, body, cta, theme (light|dark), lockup (interstellar|mothership|none), mock {template-specific}"
    },
    "caption": {
      "type": "string",
      "description": "Platform-ready caption with 3-6 hashtags (Instagram/Facebook/X/TikTok)"
    },
    "caption_linkedin": {
      "type": "string",
      "description": "LinkedIn variant of the caption"
    },
    "alt_text": {
      "type": "string"
    },
    "generation_batch": {
      "type": "string",
      "description": "Batch id, e.g. 'wk-2026-11-09'"
    },
    "generated_by": {
      "type": "string",
      "enum": [
        "claude",
        "justin"
      ],
      "default": "justin"
    },
    "planned_for": {
      "type": "string",
      "format": "date",
      "description": "Suggested posting day from the generator (Monday-Friday)"
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "before_spec": {
            "type": "object",
            "additionalProperties": true
          },
          "before_template": {
            "type": "string"
          }
        }
      }
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time",
      "description": "Legacy reminder field; use scheduled_at"
    },
    "posted_at": {
      "type": "string",
      "format": "date-time"
    },
    "posted_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "description": "Public JPEG rendered from the spec at approval (Instagram needs a public URL)"
    },
    "scheduled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the publisher posts it (UTC). Set when Justin approves."
    },
    "publish_targets": {
      "type": "object",
      "properties": {
        "instagram": {
          "type": "boolean",
          "default": true
        },
        "facebook": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Where the publisher posts it. facebook defaults to the global Auto cross-post setting."
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    },
    "declined_at": {
      "type": "string",
      "format": "date-time"
    },
    "declined_reason": {
      "type": "string"
    },
    "image_spec_hash": {
      "type": "string",
      "description": "Hash of template+spec the uploaded image_url was rendered from; the publisher refuses a stale image"
    },
    "image_rendered_at": {
      "type": "string",
      "format": "date-time"
    },
    "publish_lock": {
      "type": "string",
      "description": "Publisher run lock token (idempotency)"
    },
    "publishing_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "publish_attempts": {
      "type": "integer",
      "default": 0
    },
    "ig_container_id": {
      "type": "string"
    },
    "ig_media_id": {
      "type": "string"
    },
    "ig_permalink": {
      "type": "string"
    },
    "fb_page_id": {
      "type": "string"
    },
    "fb_post_id": {
      "type": "string"
    },
    "fb_permalink": {
      "type": "string"
    },
    "fb_error": {
      "type": "string",
      "description": "Facebook cross-post problem (Instagram may still be posted)"
    },
    "publish_error": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "insights": {
      "type": "object",
      "additionalProperties": true,
      "description": "{ likes, comments, reach, views, saved, shares, fb_reactions, fb_comments, updated_at, note }"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}