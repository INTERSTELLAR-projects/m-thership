{
  "name": "ClientGap",
  "properties": {
    "area": {
      "default": "other",
      "enum": [
        "website",
        "seo",
        "gbp",
        "brand",
        "system",
        "ops",
        "reviews",
        "social",
        "ads",
        "other"
      ],
      "type": "string"
    },
    "audit_kind": {
      "default": "manual",
      "enum": [
        "initial",
        "final",
        "manual"
      ],
      "type": "string"
    },
    "client_id": {
      "description": "CRMClient id",
      "type": "string"
    },
    "evidence": {
      "description": "What was checked and where (URL, tool, number)",
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "portal_visible": {
      "default": true,
      "type": "boolean"
    },
    "recommendation": {
      "type": "string"
    },
    "severity": {
      "default": "medium",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "type": "string"
    },
    "source_job_id": {
      "description": "ClaudeJob that found it (Intel audit); shown in the portal once Justin approves",
      "type": "string"
    },
    "status": {
      "default": "open",
      "enum": [
        "open",
        "planned",
        "in_progress",
        "fixed"
      ],
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "title"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}