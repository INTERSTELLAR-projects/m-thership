{
  "name": "ClientGap",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "CRMClient id"
    },
    "title": {
      "type": "string"
    },
    "area": {
      "type": "string",
      "enum": [
        "website",
        "seo",
        "gbp",
        "brand",
        "system",
        "ops",
        "reviews",
        "social",
        "ads",
        "other"
      ],
      "default": "other"
    },
    "severity": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "planned",
        "in_progress",
        "fixed"
      ],
      "default": "open"
    },
    "recommendation": {
      "type": "string"
    },
    "impact": {
      "type": "string"
    },
    "portal_visible": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "client_id",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}