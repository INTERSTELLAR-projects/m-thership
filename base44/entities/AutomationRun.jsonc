{
  "name": "AutomationRun",
  "type": "object",
  "properties": {
    "automation_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "CRMClient id"
    },
    "client_name": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "success",
        "failed",
        "skipped"
      ],
      "default": "success"
    },
    "message": {
      "type": "string"
    },
    "output_url": {
      "type": "string"
    },
    "work_log_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "description": "What was produced, e.g. the blog title"
    },
    "domain": {
      "type": "string",
      "description": "Client domain, used when client_id is unknown"
    },
    "automation_name": {
      "type": "string"
    },
    "processed": {
      "type": "boolean",
      "default": false
    },
    "verified_live": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}