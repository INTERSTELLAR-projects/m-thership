{
  "name": "PortalInvite",
  "type": "object",
  "description": "Log of client-portal onboarding invites. One sent invite per client (resends are explicit and logged). No passwords or tokens are ever stored here.",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "CRMClient id"
    },
    "client_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "The single login email invited. Always one of the client's portal_emails."
    },
    "source": {
      "type": "string",
      "enum": [
        "stripe",
        "manual",
        "test"
      ],
      "description": "stripe = queued by a new subscription payment; manual = sent from the client cockpit; test = sample sent to the admin only"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sent",
        "skipped",
        "needs_review",
        "failed"
      ],
      "default": "queued"
    },
    "due_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the invite should go out (stripe: the day after payment)"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_invoice_id": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "package": {
      "type": "string",
      "description": "What was paid for (Stripe line names)"
    },
    "message": {
      "type": "string",
      "description": "What happened, in plain words"
    },
    "invited_by": {
      "type": "string",
      "description": "Admin email, or 'stripe' / 'schedule'"
    },
    "resend": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "client_id",
    "email",
    "source",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}