{
  "name": "BusinessTaxProfile",
  "description": "Accounting & Tax center: one row per business (and later per client). Entity type, filing status, payments made, prior-year safe-harbor facts, connections, checklists, overrides of tax figures and the latest projection (read by the reminder function).",
  "type": "object",
  "properties": {
    "business_id": { "type": "string", "default": "interstellar" },
    "client_id": { "type": "string" },
    "business_name": { "type": "string" },
    "completed": { "type": "boolean", "default": false, "description": "True once Justin has filled and saved the profile" },
    "tax_year": { "type": "number" },
    "entity_type": { "type": "string", "enum": ["smllc_schedule_c", "sole_prop", "mmllc_1065", "s_corp_1120s", "c_corp_1120"], "default": "smllc_schedule_c" },
    "state": { "type": "string", "default": "OR" },
    "city": { "type": "string", "default": "Molalla" },
    "county": { "type": "string", "default": "Clackamas" },
    "filing_status": { "type": "string", "enum": ["single", "mfj", "mfs", "hoh"], "default": "single" },
    "qualifying_children": { "type": "number", "default": 0 },
    "other_wages": { "type": "number", "default": 0, "description": "Household W-2 wages (spouse/other jobs)" },
    "other_income": { "type": "number", "default": 0 },
    "withholding_federal": { "type": "number", "default": 0 },
    "withholding_oregon": { "type": "number", "default": 0 },
    "itemized_deductions": { "type": "number", "default": 0 },
    "se_health_insurance": { "type": "number", "default": 0 },
    "retirement_contributions": { "type": "number", "default": 0 },
    "is_sstb": { "type": "boolean", "default": false },
    "prior_year_federal_tax": { "type": "number" },
    "prior_year_oregon_tax": { "type": "number" },
    "prior_year_agi": { "type": "number" },
    "estimated_payments": { "type": "array", "items": { "type": "object", "additionalProperties": true }, "description": "[{ date, jurisdiction: federal|oregon, amount, tax_year, quarter, note }]" },
    "s_corp_salary": { "type": "number" },
    "planned_scorp_year": { "type": "number", "description": "Tax year Justin plans to elect S-corp status (e.g. 2027); null = no plan" },
    "home_office_method": { "type": "string", "enum": ["none", "simplified", "regular"], "default": "none" },
    "home_office_sqft": { "type": "number", "default": 0 },
    "home_total_sqft": { "type": "number", "default": 0 },
    "home_expenses_annual": { "type": "number", "default": 0 },
    "in_sctd_district": { "type": "boolean", "default": true },
    "in_metro_district": { "type": "boolean", "default": false },
    "cash_balance_manual": { "type": "number" },
    "reserve_balance": { "type": "number", "default": 0, "description": "Money set aside for taxes (manual or from a QuickBooks account)" },
    "reserve_account_name": { "type": "string" },
    "projection_method": { "type": "string", "enum": ["run_rate", "annualized"], "default": "run_rate" },
    "scorp_payroll_service_cost": { "type": "number", "default": 600 },
    "scorp_extra_prep_cost": { "type": "number", "default": 1500 },
    "qbo_realm_id": { "type": "string" },
    "qbo_snapshot": { "type": "object", "additionalProperties": true },
    "stripe_synced_at": { "type": "string", "format": "date-time" },
    "last_csv_import_at": { "type": "string", "format": "date-time" },
    "config_overrides": { "type": "object", "additionalProperties": true, "description": "taxConfig key -> override value" },
    "checklists": { "type": "object", "additionalProperties": true, "description": "period key (2026-Q4 / 2026-10) -> { item: true }" },
    "last_projection": { "type": "object", "additionalProperties": true, "description": "Latest computed projection summary (amounts per due date) for reminders" },
    "notes": { "type": "string" }
  },
  "required": ["business_id"],
  "rls": {"create": {"user_condition": {"role": "admin"}}, "read": {"user_condition": {"role": "admin"}}, "update": {"user_condition": {"role": "admin"}}, "delete": {"user_condition": {"role": "admin"}}}
}
