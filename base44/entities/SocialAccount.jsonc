{
  "name": "SocialAccount",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "CRMClient id this social account belongs to, or 'interstellar' for Interstellar's own accounts"
    },
    "account_kind": {
      "type": "string",
      "description": "company | personal | page | channel | board | subreddit | server (free text; LinkedIn uses company/personal)"
    },
    "display_name": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "description": "Public profile / channel URL (Open platform button)"
    },
    "target_id": {
      "type": "string",
      "description": "Where posts go: Facebook Page id, LinkedIn organization id, Pinterest board id, Telegram channel (@name or -100 id), subreddit, Threads user id"
    },
    "secret_ref": {
      "type": "string",
      "description": "Name of the Base44 Secret holding this account's webhook/token. Must start with SOCIAL_ (e.g. SOCIAL_DISCORD_WEBHOOK_INTERSTELLAR). Never the secret itself."
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "mode_override": {
      "type": "string",
      "enum": [
        "",
        "manual"
      ],
      "description": "manual = never auto-post this account even when it could"
    },
    "daily_limit": {
      "type": "number"
    },
    "own_subreddit": {
      "type": "boolean",
      "default": false,
      "description": "Reddit only: the brand owns/moderates this subreddit, so auto-posting is allowed"
    },
    "client_name": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "instagram",
        "facebook",
        "youtube",
        "linkedin",
        "tiktok",
        "threads",
        "x",
        "pinterest",
        "gbp",
        "discord",
        "telegram",
        "reddit",
        "whatsapp"
      ],
      "default": "instagram"
    },
    "handle": {
      "type": "string",
      "description": "Username without @"
    },
    "ig_user_id": {
      "type": "string"
    },
    "profile_picture_url": {
      "type": "string"
    },
    "followers_count": {
      "type": "number"
    },
    "follows_count": {
      "type": "number"
    },
    "media_count": {
      "type": "number"
    },
    "recent_media": {
      "type": "array",
      "description": "Newest first: { id, caption, permalink, image_url, timestamp, media_type, like_count, comments_count, reach }",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": true,
      "description": "{ likes, comments, reach, posts } over recent_media"
    },
    "source": {
      "type": "string",
      "enum": [
        "facebook_partner",
        "app_user_connector",
        "manual"
      ],
      "default": "manual",
      "description": "facebook_partner = read through Interstellar's Facebook Pages connection after the client gave Page/partner access"
    },
    "connected_by_email": {
      "type": "string"
    },
    "synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "sync_error": {
      "type": "string"
    },
    "invite_connect": {
      "type": "boolean",
      "default": false,
      "description": "Show the client a Connect your Instagram card in the portal Results tab"
    },
    "portal_visible": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "fb_page_id": {
      "type": "string",
      "description": "Client Facebook Page the Instagram account is linked to"
    },
    "fb_page_name": {
      "type": "string"
    },
    "insights_30d": {
      "type": "object",
      "additionalProperties": true,
      "description": "{ reach, views, accounts_engaged, total_interactions, profile_views, likes, comments, saves, shares, since, until }"
    },
    "linked_by": {
      "type": "string"
    },
    "linked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "client_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}