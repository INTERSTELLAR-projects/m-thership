{
  "name": "ExecutionPlan",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "goal_mrr": {
      "type": "number"
    },
    "baseline_mrr": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "achieved",
        "archived"
      ],
      "default": "active"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "monthly_price": {
            "type": "number"
          },
          "has_addons": {
            "type": "boolean"
          },
          "addon_low": {
            "type": "number"
          },
          "addon_high": {
            "type": "number"
          },
          "addon_avg": {
            "type": "number"
          },
          "addon_attach_rate": {
            "type": "number"
          },
          "clients_per_month": {
            "type": "number"
          },
          "monthly_churn_rate": {
            "type": "number"
          },
          "delivery_hours_per_client": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "goal_mrr"
  ]
}