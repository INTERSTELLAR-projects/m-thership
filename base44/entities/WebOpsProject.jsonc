{
  "name": "WebOpsProject",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "clientName": {
      "type": "string"
    },
    "clientId": {
      "type": "string"
    },
    "projectType": {
      "type": "string",
      "enum": [
        "Website Build",
        "Website Update",
        "Redesign",
        "Maintenance"
      ],
      "default": "Website Update"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planning",
        "In Progress",
        "Review",
        "Completed",
        "On Hold",
        "Waiting on Client"
      ],
      "default": "Planning"
    },
    "priority": {
      "type": "string",
      "enum": [
        "Standard",
        "High Priority"
      ],
      "default": "Standard"
    },
    "startDate": {
      "type": "string"
    },
    "targetDate": {
      "type": "string"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "linkedRequestIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "required": [
    "name"
  ]
}