{
  "description": "Future Oracle daily/weekly brief: top changes with sources and 'what this means for you'. Admin only.",
  "name": "OracleBrief",
  "properties": {
    "accuracy": {
      "additionalProperties": true,
      "description": "{resolved,right,wrong,partial,hit_rate,brier}",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "date": {
      "description": "YYYY-MM-DD",
      "type": "string"
    },
    "deep_topics": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "kind": {
      "default": "daily",
      "enum": [
        "daily",
        "weekly"
      ],
      "type": "string"
    },
    "new_findings": {
      "type": "number"
    },
    "summary": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "top_changes": {
      "items": {
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "headline": {
            "type": "string"
          },
          "source_title": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "topic_key": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "what_it_means": {
      "type": "string"
    }
  },
  "required": [
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}