{
  "name": "ClientFile",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "CRMClient id"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "brand_kit",
        "sop",
        "guide",
        "social",
        "presentation",
        "report",
        "contract",
        "design",
        "video",
        "email_signature",
        "other"
      ],
      "default": "other"
    },
    "file_url": {
      "type": "string"
    },
    "link_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "delivered_on": {
      "type": "string",
      "format": "date"
    },
    "portal_visible": {
      "type": "boolean",
      "default": true
    },
    "dedupe_key": {
      "type": "string",
      "description": "Set by brain-to-dossier (bk:<BrandKit id> or we:<WorkEntry id>) so a linked file is never created twice"
    }
  },
  "required": [
    "client_id",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}