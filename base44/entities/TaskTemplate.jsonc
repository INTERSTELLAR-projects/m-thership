{
  "name": "TaskTemplate",
  "description": "SOP playbook: the checklist a service runs. Started services copy these items into Tasks.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "website",
        "app",
        "branding",
        "marketing",
        "seo",
        "automation",
        "consulting",
        "internal",
        "other"
      ],
      "default": "website"
    },
    "description": {
      "type": "string"
    },
    "times_applied": {
      "type": "number",
      "default": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "priority": {
            "type": "number"
          },
          "estimated_days": {
            "type": "number"
          },
          "offset_days": {
            "type": "number"
          },
          "phase": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "service_key": {
      "type": "string",
      "description": "Playbook key used when a service is started (onboarding, website, system, orbit_local\u2026)"
    },
    "sop_code": {
      "type": "string",
      "description": "Source SOP, e.g. SOP-04"
    },
    "sort_order": {
      "type": "number",
      "default": 100
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}