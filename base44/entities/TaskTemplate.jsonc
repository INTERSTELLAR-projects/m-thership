{
  "description": "SOP playbook: the checklist a service runs. Started services copy these items into Tasks.",
  "name": "TaskTemplate",
  "properties": {
    "description": {
      "type": "string"
    },
    "items": {
      "items": {
        "properties": {
          "category": {
            "type": "string"
          },
          "estimate_amount": {
            "type": "number"
          },
          "estimate_unit": {
            "enum": [
              "min",
              "h",
              "d",
              "w",
              "mo"
            ],
            "type": "string"
          },
          "estimated_days": {
            "description": "Derived from estimated_minutes (8h working day) \u2014 kept for scheduling",
            "type": "number"
          },
          "estimated_minutes": {
            "description": "Canonical effort estimate",
            "type": "number"
          },
          "notes": {
            "type": "string"
          },
          "offset_days": {
            "description": "Working days after kickoff when this step starts",
            "type": "number"
          },
          "phase": {
            "type": "string"
          },
          "priority": {
            "type": "number"
          },
          "title": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "project_type": {
      "default": "website",
      "enum": [
        "website",
        "app",
        "branding",
        "marketing",
        "seo",
        "automation",
        "consulting",
        "internal",
        "other"
      ],
      "type": "string"
    },
    "service_key": {
      "description": "Playbook key used when a service is started (onboarding, website, system, orbit_local\u2026)",
      "type": "string"
    },
    "sop_code": {
      "description": "Source SOP, e.g. SOP-04",
      "type": "string"
    },
    "sort_order": {
      "default": 100,
      "type": "number"
    },
    "times_applied": {
      "default": 0,
      "type": "number"
    }
  },
  "required": [
    "name"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}