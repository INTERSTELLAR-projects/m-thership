{
  "name": "Presentation",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Deck title"
    },
    "project_id": {
      "type": "string",
      "description": "DeckProject this presentation belongs to"
    },
    "prompt": {
      "type": "string",
      "description": "The original prompt the deck was generated from"
    },
    "summary": {
      "type": "string",
      "description": "One line describing the deck"
    },
    "subtitle": {
      "type": "string",
      "description": "Cover subtitle"
    },
    "theme": {
      "type": "string",
      "description": "Visual theme id, or 'custom' when brand colors are used"
    },
    "brand": {
      "type": "object",
      "description": "Custom brand settings used when theme is 'custom'",
      "properties": {
        "name": {
          "type": "string",
          "description": "Brand / business name (footer, file author)"
        },
        "accentText": {
          "type": "string",
          "description": "Accent nudged for text contrast on the background"
        },
        "accent2": {
          "type": "string",
          "description": "Secondary brand color"
        },
        "headingFamily": {
          "type": "string",
          "description": "Brand heading font family (Google Fonts name)"
        },
        "bodyFamily": {
          "type": "string",
          "description": "Brand body font family (Google Fonts name)"
        },
        "logo_url": {
          "type": "string",
          "description": "Brand logo URL"
        },
        "bg": {
          "type": "string",
          "description": "Background hex color"
        },
        "fg": {
          "type": "string",
          "description": "Text hex color"
        },
        "accent": {
          "type": "string",
          "description": "Primary accent hex color"
        },
        "mode": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        "headingFont": {
          "type": "string",
          "enum": [
            "sans",
            "serif"
          ]
        }
      }
    },
    "tone": {
      "type": "string",
      "description": "Tone of voice used to write the deck"
    },
    "audience": {
      "type": "string",
      "description": "Audience the deck is written for"
    },
    "client_id": {
      "type": "string",
      "description": "CRMClient the deck is for (optional)"
    },
    "client_name": {
      "type": "string"
    },
    "brief": {
      "type": "object",
      "additionalProperties": true,
      "description": "The generation brief: topic, audience, goals, slide count, tone, look, extra"
    },
    "claude_job_id": {
      "type": "string",
      "description": "ClaudeJob building this deck (Claude Queue)"
    },
    "generation_status": {
      "type": "string",
      "enum": [
        "none",
        "waiting_claude",
        "ready"
      ],
      "default": "none",
      "description": "waiting_claude while a Claude Queue job is building it"
    },
    "generated_by": {
      "type": "string",
      "description": "pipeline_v2, chat, quick_draft or claude_queue"
    },
    "brand_source": {
      "type": "string",
      "description": "Where the brand came from: Approved brand kit, Business Brain, Client profile, Brief"
    },
    "outline": {
      "type": "object",
      "additionalProperties": true,
      "description": "The approved outline the slides were written from (outline-first generation)"
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Facts the deck is missing (needs_from_user), shown in the studio"
    },
    "slides": {
      "type": "array",
      "description": "Ordered slides in the deck",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "layout": {
            "type": "string"
          },
          "eyebrow": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "chart": {
            "type": "object",
            "description": "Chart layout: type column|bar|line|donut, unit prefix/suffix, points, note",
            "properties": {
              "type": {
                "type": "string"
              },
              "unit_prefix": {
                "type": "string"
              },
              "unit_suffix": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          },
          "quote_source": {
            "type": "string"
          },
          "stats": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "heading": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "offers": {
            "type": "array",
            "description": "Pricing / offer cards",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "price": {
                  "type": "string"
                },
                "period": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "features": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "highlighted": {
                  "type": "boolean"
                }
              }
            }
          },
          "attribution": {
            "type": "string"
          },
          "image_prompt": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "needs_visual": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}