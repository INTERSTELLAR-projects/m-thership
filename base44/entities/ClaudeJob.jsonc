{
  "description": "Send to Claude queue: a step Justin authorized Claude to do. A Claude scheduled task picks up queued jobs, does the work and returns it for approval.",
  "name": "ClaudeJob",
  "properties": {
    "brand": {
      "description": "Build Engine: brand the job is for (interstellar, diald, ...)",
      "type": "string"
    },
    "instruction": {
      "description": "Build Engine: Justin's instruction as typed (instructions holds the full brief)",
      "type": "string"
    },
    "references": {
      "description": "Build Engine: reference links and uploaded files (screen recordings, images of the look)",
      "items": { "additionalProperties": true, "type": "object" },
      "type": "array"
    },
    "progress_notes": {
      "description": "Build Engine: running notes from the build agent (step 3)",
      "items": { "additionalProperties": true, "type": "object" },
      "type": "array"
    },
    "result_url": {
      "description": "Build Engine: where the result lives (preview URL, app, doc)",
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "approved_at": {
      "format": "date-time",
      "type": "string"
    },
    "attempts": {
      "default": 0,
      "type": "number"
    },
    "client_id": {
      "description": "CRMClient id",
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "complete_task_on_approve": {
      "default": true,
      "type": "boolean"
    },
    "context": {
      "additionalProperties": true,
      "type": "object"
    },
    "extra": {
      "description": "Anything Justin added when he sent it",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "type": "string"
    },
    "instructions": {
      "description": "The full brief Claude works from",
      "type": "string"
    },
    "kind": {
      "default": "task",
      "enum": [
        "task",
        "audit",
        "build_website",
        "build_app",
        "blog",
        "gbp_post",
        "report",
        "brand",
        "email",
        "research",
        "presentation",
        "playbook",
        "content_plan",
        "social_plan",
        "enrich_profile",
        "map_pack_plan",
        "topic_calendar",
        "lead_build",
        "checklist_item",
        "command",
        "other"
      ],
      "type": "string"
    },
    "needs_from_justin": {
      "description": "Anything Claude could not do without him (logins, a decision, a send)",
      "type": "string"
    },
    "not_before": {
      "description": "YYYY-MM-DD (Pacific). The queue runner leaves the job alone until this date (scheduled blog posts from an approved Topic Calendar).",
      "format": "date",
      "type": "string"
    },
    "next_stage": {
      "description": "Set by Claude when more stages remain; approving queues the next stage automatically",
      "type": "string"
    },
    "parent_job_id": {
      "description": "Previous stage of the same build",
      "type": "string"
    },
    "priority": {
      "default": 3,
      "type": "number"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "type": "string"
    },
    "result_body": {
      "description": "Markdown: what Claude did or drafted",
      "type": "string"
    },
    "result_links": {
      "items": {
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "result_summary": {
      "type": "string"
    },
    "result_data": {
      "additionalProperties": true,
      "description": "Structured result for typed jobs (e.g. a brand kit JSON). Saved to its target record only when Justin approves.",
      "type": "object"
    },
    "review_notes": {
      "type": "string"
    },
    "runner_log": {
      "type": "string"
    },
    "stage": {
      "default": 1,
      "description": "Multi-stage builds: which stage this job is",
      "type": "number"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "default": "queued",
      "enum": [
        "queued",
        "running",
        "needs_review",
        "needs_approval",
        "changes_requested",
        "approved",
        "done",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "instructions"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}