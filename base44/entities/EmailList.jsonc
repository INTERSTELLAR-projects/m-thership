{
  "name": "EmailList",
  "type": "object",
  "description": "Saved Email Studio recipient lists: a mix of CRM clients, subscribers (by id or tag) and extra addresses.",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "client_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subscriber_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subscriber_tag": {
      "type": "string",
      "description": "Include every subscribed subscriber with this tag"
    },
    "emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extra addresses"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}