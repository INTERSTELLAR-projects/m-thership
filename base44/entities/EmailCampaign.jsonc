{
  "name": "EmailCampaign",
  "type": "object",
  "description": "A client Studios email campaign through Amazon SES. Recipients live in EmailSendBatch rows (500 each); the email-bulk drain job sends them with rate limiting, promotes scheduled batches when due and runs automations. Opens/clicks are EmailEvent rows.",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "html": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "from_email": {
      "type": "string"
    },
    "from_name": {
      "type": "string"
    },
    "reply_to": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "queued",
        "sending",
        "sent",
        "partial",
        "failed",
        "cancelled",
        "paused"
      ],
      "default": "queued",
      "description": "draft = being written; scheduled = waits for send_at (batches status scheduled with per-batch not_before); paused = out of fuel (waits in place, resumes after a Refuel or the monthly reset)"
    },
    "fuel_paused_at": {
      "type": "string",
      "format": "date-time"
    },
    "metered": {
      "type": "boolean",
      "description": "true once the campaign's emails were metered (UsageLedger). Paused campaigns are metered when they resume."
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "sent_count": {
      "type": "number",
      "default": 0
    },
    "failed_count": {
      "type": "number",
      "default": 0
    },
    "skipped_count": {
      "type": "number",
      "default": 0
    },
    "batches": {
      "type": "number",
      "default": 0
    },
    "created_by": {
      "type": "string"
    },
    "by_admin": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "Client email blocks (base44/shared/clientEmail.ts). html is rendered from these at schedule/send time."
    },
    "audience": {
      "type": "object",
      "additionalProperties": true,
      "description": "{ list_ids: [], segment_id, exclude_segment_id }"
    },
    "send_at": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled send (UTC). For subscriber-time-zone sends: the earliest batch time."
    },
    "send_local": {
      "type": "string",
      "description": "YYYY-MM-DDTHH:mm wall-clock time chosen by the client"
    },
    "send_tz": {
      "type": "string",
      "description": "IANA zone the wall-clock time is in (client zone)"
    },
    "tz_mode": {
      "type": "string",
      "enum": [
        "fixed",
        "subscriber"
      ],
      "default": "fixed",
      "description": "subscriber = each batch goes at send_local in the contact time zone"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tracked link targets; click tokens carry the index. Redirects only ever go to these."
    },
    "track": {
      "type": "boolean",
      "default": true
    },
    "stats": {
      "type": "object",
      "additionalProperties": true,
      "description": "Cached results (email-client campaign_results)"
    },
    "stats_at": {
      "type": "string",
      "format": "date-time"
    },
    "dry_run": {
      "type": "boolean",
      "default": false,
      "description": "Test client (usage_overrides.email_dry_run): batches are processed but nothing is sent to SES"
    },
    "dry_run_sample": {
      "type": "string",
      "description": "Last rendered HTML in dry-run mode (QA)"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "type": "string"
    },
    "test": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "client_id",
    "subject"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
