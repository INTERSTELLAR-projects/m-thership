{
  "name": "EmailCampaign",
  "type": "object",
  "description": "A client Studios bulk email send through Amazon SES. Recipients live in EmailSendBatch rows (500 each); the email-bulk function drains them with rate limiting.",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "html": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "from_email": {
      "type": "string"
    },
    "from_name": {
      "type": "string"
    },
    "reply_to": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "sending",
        "sent",
        "partial",
        "failed",
        "cancelled",
        "paused"
      ],
      "default": "queued",
      "description": "paused = out of fuel: the campaign waits in place (not metered yet) and resumes automatically after a Refuel or the monthly reset"
    },
    "fuel_paused_at": {
      "type": "string",
      "format": "date-time"
    },
    "metered": {
      "type": "boolean",
      "description": "true once the campaign's emails were metered (UsageLedger). Paused campaigns are metered when they resume."
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "sent_count": {
      "type": "number",
      "default": 0
    },
    "failed_count": {
      "type": "number",
      "default": 0
    },
    "skipped_count": {
      "type": "number",
      "default": 0
    },
    "batches": {
      "type": "number",
      "default": 0
    },
    "created_by": {
      "type": "string"
    },
    "by_admin": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "subject"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}