{
  "name": "FormTemplate",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Web \u00d8ps",
        "F\u00f8rge",
        "\u00d8rbit SEO",
        "Performance",
        "Other"
      ]
    },
    "formType": {
      "type": "string",
      "enum": [
        "request",
        "intake"
      ],
      "default": "request"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "published": {
      "type": "boolean",
      "default": false
    },
    "publishedDate": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category",
    "fields"
  ]
}