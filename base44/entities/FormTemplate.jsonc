{
  "name": "FormTemplate",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Web Øps",
        "Førge",
        "Ørbit SEO",
        "Performance",
        "Other"
      ]
    },
    "formType": {
      "type": "string",
      "enum": [
        "request",
        "intake"
      ],
      "default": "request"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "published": {
      "type": "boolean",
      "default": false
    },
    "publishedDate": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category",
    "fields"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}