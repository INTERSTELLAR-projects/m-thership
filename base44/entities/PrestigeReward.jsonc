{
  "name": "PrestigeReward",
  "type": "object",
  "properties": {
    "memberId": {
      "type": "string"
    },
    "memberName": {
      "type": "string"
    },
    "referralId": {
      "type": "string",
      "description": "Referral that earned it (booked / signed rewards)"
    },
    "referredClientName": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "booked",
        "signed",
        "tier"
      ]
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "priority_pass",
        "credit_500",
        "tier_unlock"
      ],
      "description": "What was earned: priority_pass (referral booked a call: next request jumps the build queue, no cash value), credit_500 ($500 Interstellar credit added to the balance when the referral pays their first invoice), tier_unlock (ladder unlock)"
    },
    "tier_index": {
      "type": "number",
      "description": "1-based tier index for tier unlock rewards"
    },
    "title": {
      "type": "string"
    },
    "value": {
      "type": "number",
      "default": 0,
      "description": "Dollar value. For credit_500 this is the credit added to the member's balance (500); priority_pass is 0"
    },
    "status": {
      "type": "string",
      "enum": [
        "owed",
        "delivered",
        "void"
      ],
      "default": "owed"
    },
    "earned_at": {
      "type": "string"
    },
    "delivered_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "memberId",
    "kind",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}