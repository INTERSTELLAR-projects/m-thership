{
  "name": "Login",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "loginType": {
      "type": "string",
      "default": "Email + Password"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "platform"
  ]
}