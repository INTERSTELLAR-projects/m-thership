{
  "name": "CRMClient",
  "type": "object",
  "properties": {
    "business": {
      "type": "string"
    },
    "contact": {
      "type": "string"
    },
    "phones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "websites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Inactive",
        "Lead"
      ],
      "default": "Active"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "blogSchedule": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "completedTasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "services_managed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "website",
          "system",
          "orbit_seo",
          "brand",
          "starship_care"
        ]
      }
    },
    "plan": {
      "type": "string",
      "description": "e.g. ALPHA + Ørbit Local"
    },
    "domain": {
      "type": "string"
    },
    "site_app_id": {
      "type": "string",
      "description": "Base44 app id of their website"
    },
    "ops_app_id": {
      "type": "string",
      "description": "Base44 app id of their system"
    },
    "orbit_client_id": {
      "type": "string"
    },
    "portal_enabled": {
      "type": "boolean",
      "default": false
    },
    "portal_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accent": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "started_on": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "business"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}