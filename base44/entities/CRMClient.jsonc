{
  "name": "CRMClient",
  "properties": {
    "accent": {
      "type": "string"
    },
    "blogSchedule": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer id; set by the Stripe sync so subscriptions land on the right client"
    },
    "stripe_customer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Every Stripe customer that pays for this client (a client can have more than one payer)"
    },
    "stripe_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "description": "Set by the Stripe sync. inactive = the client's HyperCare+/Grav\u00eftyCare subscription was canceled or ended and no off-Stripe care line remains: Studios lock and the portal shows a friendly 'plan inactive, contact us' screen. Data is kept."
    },
    "plan_inactive_at": {
      "type": "string",
      "format": "date-time"
    },
    "plan_inactive_reason": {
      "type": "string"
    },
    "bundle": {
      "description": "Package name shared by clients billed together as one deal (e.g. 'Chase package'). Clients with the same bundle show as one card with a combined monthly total.",
      "type": "string"
    },
    "business": {
      "type": "string"
    },
    "completedTasks": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "contact": {
      "type": "string"
    },
    "documents": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "domain": {
      "type": "string"
    },
    "emails": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "industry": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "martian_color": {
      "type": "string",
      "description": "Comms avatar color override (hex). Empty = default by client name, then accent, then a hashed palette color."
    },
    "notes": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "ops_app_id": {
      "description": "Base44 app id of their system",
      "type": "string"
    },
    "command_app_id": {
      "description": "App id of this client's command system that may push into M\u00f8thership (client-brain ingest with COMMAND_SYSTEM_SYNC_KEY). A push is accepted for this client only from this app id. docs/client-brain-sync.md",
      "type": "string"
    },
    "brand_id": {
      "type": "string",
      "description": "Brand id (House of Brands) this client was sold through. Empty = Interstellar direct. See /brands"
    },
    "other_app_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extra Base44 apps registered to this client besides command_app_id (e.g. an onboarding form or a project tracker). Additive: never replaces command_app_id. client-brain accepts pushes from these too (shared/clientBrain.js registeredAppIds)."
    },
    "orbit_client_id": {
      "type": "string"
    },
    "phones": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "plan": {
      "description": "e.g. ALPHA + \u00d8rbit Local",
      "type": "string"
    },
    "portal_emails": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "portal_enabled": {
      "default": false,
      "type": "boolean"
    },
    "services": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "services_history": {
      "description": "Billing lines that are no longer live in Stripe (replaced by a merge, canceled, or typed in by hand). Never counted toward MRR.",
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "stripe_mrr": {
      "description": "Sum of this client's active + trialing Stripe subscriptions, per month, as of stripe_synced_at.",
      "type": "number"
    },
    "stripe_plan": {
      "description": "One line per live Stripe subscription, written by the Stripe sync (e.g. 'Google + SEO management $320/mo').",
      "type": "string"
    },
    "services_managed": {
      "items": {
        "enum": [
          "website",
          "system",
          "orbit_seo",
          "brand",
          "starship_care",
          "website_care"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "submit_intake": {
      "description": "Portal Submit intake (jobs, before & afters, drops, testimonials, events). On for every client unless set to false.",
      "default": true,
      "type": "boolean"
    },
    "website_published_at": {
      "description": "Build Engine: first time the website was published on its base44.app address (Ready to publish). Not live yet.",
      "format": "date-time",
      "type": "string"
    },
    "website_domain": {
      "description": "Build Engine: the client's own domain once connected and verified",
      "type": "string"
    },
    "market_scope": {
      "type": "string",
      "enum": [
        "",
        "local",
        "national",
        "global"
      ],
      "default": "",
      "description": "Brain unlocks: local clients need NAP + service area; national/global clients need topics instead. Empty = read from the scrape (market)."
    },
    "blog_frequency": {
      "type": "string",
      "enum": [
        "",
        "weekly",
        "2_per_month",
        "monthly"
      ],
      "default": "",
      "description": "Blog engine frequency chosen for this client (growth unlock). Posting itself stays off by Justin's rule."
    },
    "unlocks_auto": {
      "type": "boolean",
      "default": false,
      "description": "Brain unlocks prepare their work automatically for Build Engine clients (they have a BuildChecklist). Set true to include a client without one."
    },
    "site_key": {
      "type": "string",
      "description": "Public, non-secret key the client's website uses to read its own season + offers from the site-config function"
    },
    "website_live_at": {
      "description": "Build Engine: the moment the client's own domain was connected AND verified (custom-domains status verified). This is what 'live' means: it plays the portal launch animation, switches live-site automations from setup to active and marks the build Launched.",
      "format": "date-time",
      "type": "string"
    },
    "command_live_at": {
      "description": "Build Engine: first time the Command System went live through Ready to publish (portal launch animation)",
      "format": "date-time",
      "type": "string"
    },
    "site_app_id": {
      "description": "Base44 app id of their website",
      "type": "string"
    },
    "started_on": {
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "Active",
      "enum": [
        "Active",
        "Inactive",
        "Lead"
      ],
      "type": "string"
    },
    "websites": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "pipeline_stage_by": {
      "description": "Who made the last stage move: a person's email, 'claude', 'assistant' or 'automation:<trigger>'. Set together with pipeline_stage when Claude or an automation moves a lead.",
      "type": "string"
    },
    "pipeline_stage_reason": {
      "description": "Why the last stage move happened (shown in the move log as 'Moved by Claude: <reason>')",
      "type": "string"
    },
    "pipeline_stage_logged": {
      "description": "The stage the move log last recorded. A direct edit of pipeline_stage that differs is picked up and logged by the 'Leads \u2014 log stage changes' workflow.",
      "type": "string"
    },
    "deal_one_time": {
      "description": "Deal value, one-time part (build/project price): {amount, status: quoted|invoiced|partly_paid|paid, paid_amount, source: manual|stripe, stripe_invoice_id, label}",
      "additionalProperties": true,
      "type": "object"
    },
    "deal_monthly": {
      "description": "Deal value, monthly plan: {plan: hypercare|gravitycare|none, amount, start: now|build_done|date, start_date}. Committed, not in Stripe yet, until the Stripe subscription exists; then Stripe wins.",
      "additionalProperties": true,
      "type": "object"
    },
    "pipeline_stage": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "call_booked",
        "call_held",
        "proposal_sent",
        "won",
        "lost"
      ],
      "description": "Sales pipeline stage for leads (Pipeline page). Missing on older leads: derived from notes."
    },
    "gbp_url": {
      "description": "Google Business Profile link (Build Engine quick-add)",
      "type": "string"
    },
    "one_liner": {
      "description": "What they do, in one line (Build Engine quick-add)",
      "type": "string"
    },
    "lead_references": {
      "description": "Reference links and uploaded screen recordings or images of the look Justin wants: [{kind: link|file, url, name, note}]",
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "niche_key": {
      "description": "Build Engine niche template key",
      "enum": [
        "home_service",
        "fitness_coach",
        "retail_streetwear",
        "food_bev",
        "other"
      ],
      "type": "string"
    },
    "portal_tier": {
      "type": "string",
      "enum": [
        "lead",
        "client"
      ],
      "description": "Lead Engine two-tier portal. lead = the login sees only their preview (website + Command System demo), what Interstellar is and the walkthrough booking. client (or empty, for every existing client) = the full portal. Flips to client automatically when the lead becomes Active/paid (lead-stage won, Stripe sync) or by hand; a downgrade never deletes data."
    },
    "portal_tier_changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "industry_key": {
      "type": "string",
      "description": "Lead Engine IndustryTemplate key (e.g. tree_service). Picks the template a preview is built from."
    },
    "place_id": {
      "type": "string",
      "description": "Google Places place id. Kept permanently (allowed by the Places terms); other Places fields live in gbp_cache."
    },
    "gbp_cache": {
      "type": "object",
      "additionalProperties": true,
      "description": "Cached Google Places fields (name, category, rating, review_count, phone, website, address, maps_url, photo_count). Refreshed on view after 30 days (gbp_fetched_at)."
    },
    "gbp_fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "description": "Two-letter US state (Lead Finder)"
    },
    "city": {
      "type": "string",
      "description": "City (Lead Finder)"
    },
    "lead_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lead Finder flags: no_website, dated, few_reviews, few_photos"
    },
    "site_check": {
      "type": "object",
      "additionalProperties": true,
      "description": "Lightweight homepage check: {at, dated, reasons, copyright}"
    },
    "do_not_contact": {
      "type": "boolean",
      "default": false,
      "description": "Blocks calls and emails from the Lead Desk. Set when the person asks, or by an opt-out link."
    },
    "dnc_reason": {
      "type": "string"
    },
    "dnc_at": {
      "type": "string",
      "format": "date-time"
    },
    "email_opt_out": {
      "type": "boolean",
      "default": false,
      "description": "Opted out of Lead Engine emails through the link in the invite email"
    },
    "lead_incentive": {
      "type": "object",
      "additionalProperties": true,
      "description": "$1/minute walkthrough incentive: {status: none|owed|paid, amount, minutes, method: Venmo|Cash App|PayPal|Check, paid_at, note}. Never account numbers or handles."
    },
    "desk_outcome": {
      "type": "string",
      "description": "Last Lead Desk outcome (no_answer, callback, not_interested, booked, sent_portal)"
    },
    "desk_last_call_at": {
      "type": "string",
      "format": "date-time"
    },
    "assigned_rep_id": {
      "type": "string",
      "description": "SalesRep who owns this lead (round-robin or manual)"
    },
    "assigned_rep_name": {
      "type": "string"
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    },
    "build_queue": { "type": "object", "additionalProperties": true, "description": "Lead Engine build queue: {status: pending|queued|building|ready|failed|skipped, reason, attempts, next_try_at, approved_at, approved_by, done_at}. Lead Finder adds leads as pending (Approve to build); approved leads are scraped and their template preview built in the background under a daily cap with backoff." },
    "lead_heat": { "type": "string", "enum": ["cold", "warm", "hot", "hottest", "booked"], "description": "From portal engagement (sent, opened, came back)" },
    "callback_at": { "type": "string", "format": "date-time", "description": "When they asked to be called back" },
    "portfolio_item_id": { "type": "string", "description": "PortfolioItem made when this client's site launched (stops the launch workflow re-running)" },
    "builder_rep_id": {
      "type": "string",
      "description": "SalesRep who built the preview (first right to present it)"
    },
    "scrape_status": {
      "enum": [
        "none",
        "running",
        "done",
        "failed"
      ],
      "type": "string"
    },
    "scraped_at": {
      "format": "date-time",
      "type": "string"
    },
    "scrape_summary": {
      "description": "Clean summary of the last scrape for the lead card (never invented; missing facts are listed in not_found)",
      "additionalProperties": true,
      "type": "object"
    },
    "lead_source": {
      "type": "string",
      "description": "Where the lead came from: a value from Settings > Lists & fields > Lead sources (defaults website, funnel, referral, cold, ads, social, other)"
    },
    "lead_funnel": {
      "type": "string",
      "description": "Funnel name when lead_source is funnel (Interstellar Booking)"
    },
    "lead_referrer": {
      "type": "string",
      "description": "Who referred this lead (free text)"
    },
    "lead_referrer_member_id": {
      "type": "string",
      "description": "PrestigeMember id when the referrer is a Prestige member"
    },
    "lead_interest": {
      "type": "string",
      "description": "What the lead is most interested in (Mission ALPHA, BRAVO, HyperCare+, ...)"
    },
    "lead_details": {
      "type": "object",
      "additionalProperties": true,
      "description": "Qualifying answers: annual_revenue, team_size, timeline, biggest_problem, utm_*"
    },
    "lead_value": {
      "type": "number",
      "description": "Estimated deal value ($)"
    },
    "next_step": {
      "type": "string"
    },
    "next_step_at": {
      "type": "string",
      "format": "date"
    },
    "lost_reason": {
      "type": "string"
    },
    "stage_changed_at": {
      "type": "string",
      "format": "date-time"
    },
    "booked_call_at": {
      "type": "string",
      "description": "Booked strategy call (ISO date-time when parseable, else date)"
    },
    "studios": {
      "type": "object",
      "description": "Client portal Studio states per client: off (hidden), preview (visible, locked; default), on (usable). Missing key = preview. Set in M\u00f8thership > Client usage.",
      "properties": {
        "social": {
          "type": "string",
          "enum": [
            "off",
            "preview",
            "on"
          ],
          "default": "preview"
        },
        "email": {
          "type": "string",
          "enum": [
            "off",
            "preview",
            "on"
          ],
          "default": "preview"
        },
        "ads": {
          "type": "string",
          "enum": [
            "off",
            "preview",
            "on"
          ],
          "default": "preview"
        },
        "accounting": {
          "type": "string",
          "enum": [
            "off",
            "preview",
            "on"
          ],
          "default": "preview"
        },
        "hiring": {
          "type": "string",
          "enum": [
            "off",
            "preview",
            "on"
          ],
          "default": "preview"
        },
        "presentations": {
          "type": "string",
          "enum": [
            "off",
            "preview",
            "on"
          ],
          "default": "preview"
        }
      },
      "additionalProperties": false
    },
    "usage_overrides": {
      "type": "object",
      "additionalProperties": true,
      "description": "Fair-use overrides: plan (hypercare|website|gravitycare|none), ai_actions (number), marketing_emails (number), ads_cadence (daily|weekly|none), unlimited (bool), note"
    },
    "ses_from_email": {
      "type": "string",
      "description": "Verified SES sending address for this client's marketing email (e.g. news@clientdomain.com)"
    },
    "ses_from_name": {
      "type": "string",
      "description": "Display name on this client's marketing email"
    },
    "ses_reply_to": {
      "type": "string"
    },
    "ses_domain": {
      "type": "string",
      "description": "Sending domain verified in Amazon SES (DKIM)"
    },
    "ses_domain_verified": {
      "type": "boolean",
      "default": false,
      "description": "Justin confirms the domain shows Verified in SES before client sends are allowed"
    }
  },
  "required": [
    "business"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}