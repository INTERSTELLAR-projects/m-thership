{
  "name": "CRMClient",
  "properties": {
    "accent": {
      "type": "string"
    },
    "blogSchedule": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "stripe_customer_id": { "type": "string", "description": "Stripe customer id; set by the Stripe sync so subscriptions land on the right client" },
    "stripe_synced_at": { "type": "string", "format": "date-time" },
    "bundle": {
      "description": "Package name shared by clients billed together as one deal (e.g. 'Chase package'). Clients with the same bundle show as one card with a combined monthly total.",
      "type": "string"
    },
    "business": {
      "type": "string"
    },
    "completedTasks": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "contact": {
      "type": "string"
    },
    "documents": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "domain": {
      "type": "string"
    },
    "emails": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "industry": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "notes": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "ops_app_id": {
      "description": "Base44 app id of their system",
      "type": "string"
    },
    "orbit_client_id": {
      "type": "string"
    },
    "phones": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "plan": {
      "description": "e.g. ALPHA + \u00d8rbit Local",
      "type": "string"
    },
    "portal_emails": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "portal_enabled": {
      "default": false,
      "type": "boolean"
    },
    "services": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "array"
    },
    "services_managed": {
      "items": {
        "enum": [
          "website",
          "system",
          "orbit_seo",
          "brand",
          "starship_care"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "site_app_id": {
      "description": "Base44 app id of their website",
      "type": "string"
    },
    "started_on": {
      "format": "date",
      "type": "string"
    },
    "status": {
      "default": "Active",
      "enum": [
        "Active",
        "Inactive",
        "Lead"
      ],
      "type": "string"
    },
    "websites": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "business"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}