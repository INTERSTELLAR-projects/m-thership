{
  "name": "ConversationMessage",
  "type": "object",
  "properties": {
    "senderEmail": {
      "type": "string"
    },
    "recipientEmail": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "messageType": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "document",
        "audio"
      ],
      "default": "text"
    },
    "timestamp": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "CRMClient id"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "admin",
        "client"
      ],
      "default": "admin"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "When Interstellar (admin) read it. For 1:1 admin messages, when the client read it."
    },
    "thread_id": {
      "type": "string",
      "description": "ChatThread id for group chats. Empty = the client's 1:1 thread with Interstellar (keyed by client_id)."
    },
    "sender_client_id": {
      "type": "string",
      "description": "CRMClient id of the client who sent it (group chats; client_id stays empty on group messages so they never land in a 1:1)."
    },
    "sender_name": {
      "type": "string"
    },
    "read_by_client_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Group chats: CRMClient ids that have read this message."
    }
  },
  "required": [
    "senderEmail",
    "recipientEmail",
    "content",
    "timestamp"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}