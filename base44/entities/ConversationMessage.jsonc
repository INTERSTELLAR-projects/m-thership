{
  "name": "ConversationMessage",
  "type": "object",
  "properties": {
    "senderEmail": {
      "type": "string"
    },
    "recipientEmail": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "messageType": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "document",
        "audio"
      ],
      "default": "text"
    },
    "timestamp": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "CRMClient id"
    },
    "sender_role": {
      "type": "string",
      "enum": [
        "admin",
        "client"
      ],
      "default": "admin"
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "senderEmail",
    "recipientEmail",
    "content",
    "timestamp"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}