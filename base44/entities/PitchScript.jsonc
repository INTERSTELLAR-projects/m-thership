{
  "name": "PitchScript",
  "description": "Interstellar Strategies pitch in three lengths (30 seconds, 2 minutes, 10 minutes), generated by callPrepAgent (mode pitch) from the positioning BrainFacts (source = positioning) and editable on /calls?view=pitch. No invented stats, clients or prices. Admin only.",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "default": "interstellar",
      "description": "One row per brand; interstellar for now"
    },
    "pitch_30s": {
      "type": "string"
    },
    "pitch_2min": {
      "type": "string"
    },
    "pitch_10min": {
      "type": "string"
    },
    "facts_used": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "BrainFact ids the pitch was built from"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "edited_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}