{
  "name": "OrbitSEOClient",
  "type": "object",
  "properties": {
    "clientId": {
      "type": "string"
    },
    "businessName": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "primaryLocation": {
      "type": "string"
    },
    "serviceLocations": {
      "type": "string"
    },
    "serviceType": {
      "type": "string",
      "enum": [
        "Local",
        "National",
        "International"
      ],
      "default": "Local"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Needs Attention",
        "Paused"
      ],
      "default": "Active"
    },
    "blogFrequency": {
      "type": "string"
    },
    "blogDays": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "lastBlogPosted": {
      "type": "string"
    },
    "nextBlogDue": {
      "type": "string"
    },
    "gbpStatus": {
      "type": "string",
      "enum": [
        "Active",
        "Needs Attention",
        "Not Applicable",
        "Paused"
      ],
      "default": "Active"
    },
    "gbpLastPost": {
      "type": "string"
    },
    "gbpNextDue": {
      "type": "string"
    },
    "gbpFrequency": {
      "type": "string"
    },
    "gbpDays": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "googleShopStatus": {
      "type": "string"
    },
    "blogsPublishedCount": {
      "type": "number",
      "default": 0
    },
    "gbpPostsDoneCount": {
      "type": "number",
      "default": 0
    },
    "offerPositioning": {
      "type": "object",
      "additionalProperties": true
    },
    "problemSolution": {
      "type": "object",
      "additionalProperties": true
    },
    "seoStrategy": {
      "type": "object",
      "additionalProperties": true
    },
    "blogs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "gbpPosts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "businessName"
  ]
}