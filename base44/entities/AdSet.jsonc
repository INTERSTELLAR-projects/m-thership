{
  "name": "AdSet",
  "type": "object",
  "properties": {
    "account_ref": {
      "type": "string"
    },
    "campaign_ref": {
      "type": "string",
      "description": "AdCampaign id"
    },
    "platform": {
      "type": "string",
      "description": "Ad platform",
      "enum": [
        "meta",
        "google",
        "tiktok",
        "linkedin"
      ]
    },
    "external_id": {
      "type": "string"
    },
    "external_campaign_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "effective_status": {
      "type": "string"
    },
    "daily_budget": {
      "type": "number",
      "description": "Major units"
    },
    "lifetime_budget": {
      "type": "number"
    },
    "optimization_goal": {
      "type": "string"
    },
    "billing_event": {
      "type": "string"
    },
    "targeting": {
      "type": "object",
      "additionalProperties": true
    },
    "client_id": {
      "type": "string",
      "description": "CRMClient id when this belongs to a client (future paid portal add-on). Empty = Interstellar's own ads."
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}