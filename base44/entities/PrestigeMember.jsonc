{
  "name": "PrestigeMember",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "prestige": {
      "type": "string",
      "enum": [
        "Recruit",
        "Prestige I",
        "Prestige II",
        "Prestige III",
        "Prestige IV",
        "Prestige V",
        "Prestige Master"
      ],
      "default": "Prestige I"
    },
    "totalReferrals": {
      "type": "number",
      "default": 0
    },
    "joinDate": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "client_id": {
      "type": "string",
      "description": "CRMClient this referrer is (lets the client see their referral progress in the portal)"
    },
    "referral_code": {
      "type": "string",
      "description": "Short code appended to the referral link (?ref=code)"
    },
    "last_celebrated_tier": {
      "type": "number",
      "description": "Highest tier index (1-based) whose unlock animation has played in M\u00f8thership"
    },
    "client_celebrated_tier": {
      "type": "number",
      "description": "Highest tier index (1-based) whose unlock animation the client has seen in the portal"
    }
  },
  "required": [
    "name",
    "prestige"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}