{
  "name": "EmailContact",
  "type": "object",
  "description": "Client Email Studio contacts (one row per client + email). Admin-only RLS; portal users reach them only through the email-client function, scoped to their own client. Never mixed with Interstellar's own EmailSubscriber list.",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "CRMClient id"
    },
    "email": {
      "type": "string",
      "description": "Lowercased; unique per client",
      "format": "email"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Display name"
    },
    "phone": {
      "type": "string"
    },
    "list_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "EmailContactList ids"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lowercased tags"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "description": "IANA time zone, e.g. America/Los_Angeles (send-in-their-time-zone)"
    },
    "birthday": {
      "type": "string",
      "description": "MM-DD or YYYY-MM-DD"
    },
    "anniversary": {
      "type": "string",
      "description": "YYYY-MM-DD (customer since / anniversary)"
    },
    "fields": {
      "type": "object",
      "additionalProperties": true,
      "description": "Custom fields { key: string }"
    },
    "status": {
      "type": "string",
      "enum": [
        "subscribed",
        "pending",
        "unsubscribed",
        "cleaned"
      ],
      "default": "subscribed",
      "description": "pending = waiting for double opt-in; cleaned = hard bounce / complaint"
    },
    "source": {
      "type": "string",
      "description": "import | form | webhook | manual"
    },
    "source_detail": {
      "type": "string",
      "description": "File name, form name or event"
    },
    "consent": {
      "type": "object",
      "additionalProperties": true,
      "description": "{ basis: express | existing_customer | double_opt_in, source, text, at, by, ip_hash }"
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "unsubscribed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_clicked_at": {
      "type": "string",
      "format": "date-time"
    },
    "sent_count": {
      "type": "number",
      "default": 0
    },
    "open_count": {
      "type": "number",
      "default": 0
    },
    "click_count": {
      "type": "number",
      "default": 0
    },
    "test": {
      "type": "boolean",
      "default": false,
      "description": "Labeled QA/demo contact (example.com). Never really sent."
    }
  },
  "required": [
    "client_id",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
