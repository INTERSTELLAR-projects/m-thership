{
  "name": "EmailSendBatch",
  "type": "object",
  "description": "Up to 500 recipients of one EmailCampaign, sent one email per recipient by email-bulk.",
  "properties": {
    "campaign_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "index": {
      "type": "number"
    },
    "recipients": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "pending",
        "sending",
        "done",
        "failed",
        "held",
        "cancelled"
      ],
      "default": "pending",
      "description": "scheduled = waits for not_before; held = the campaign is paused (client out of fuel); set back to pending when it resumes; cancelled = campaign cancelled before send"
    },
    "cursor": {
      "type": "number",
      "default": 0
    },
    "sent": {
      "type": "number",
      "default": 0
    },
    "failed": {
      "type": "number",
      "default": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "attempts": {
      "type": "number",
      "default": 0
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "not_before": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled batches are promoted to pending at this time"
    },
    "tz": {
      "type": "string",
      "description": "Time zone this batch was grouped by (subscriber-time-zone sends)"
    }
  },
  "required": [
    "campaign_id",
    "client_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
