{
  "name": "CallPrep",
  "description": "Structure call: one planned call (client, sales, investor, partner, win-back or internal). Justin dictates what he needs to cover (raw_notes, verbatim); the callPrepAgent function turns it into a goal, a timeboxed agenda (decisions first), a prep checklist, asks and risks, with open action items from the last calls rolled forward. After the call he dictates outcomes; the debrief proposes action items and brain facts, and each fact is written as a BrainFact on the client only after he accepts it. Admin only. Cheat-sheet layout (remember, background, show, questions with answers) is the default view; PDFs are saved on the record so every prep is kept.",
  "type": "object",
  "properties": {
    "call_type": {
      "type": "string",
      "enum": [
        "client",
        "sales_discovery",
        "sales_close",
        "investor",
        "partner",
        "win_back",
        "internal"
      ],
      "default": "client",
      "description": "Changes how the agent structures the call"
    },
    "client_id": {
      "type": "string",
      "description": "CRMClient id (optional for prospects, investors, partners and internal calls)"
    },
    "client_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "done"
      ],
      "default": "draft"
    },
    "raw_notes": {
      "type": "string",
      "description": "What Justin said or typed, verbatim"
    },
    "goal": {
      "type": "string",
      "description": "One sentence: what must be true when the call ends"
    },
    "structure": {
      "type": "string",
      "description": "The call plan as clean markdown (Copy for call)"
    },
    "agenda": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "minutes": {
            "type": "number"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "decide",
              "inform",
              "ask",
              "show"
            ]
          },
          "talking_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision_needed": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        }
      }
    },
    "timebox_minutes": {
      "type": "number",
      "default": 25
    },
    "prep_checklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "asks_from_client": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Things in raw_notes that disagree with stored facts, flagged by the agent"
    },
    "follow_ups": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Open action items rolled forward from earlier calls"
    },
    "outcomes": {
      "type": "string",
      "description": "After-call notes, verbatim"
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "owner": {
            "type": "string",
            "enum": [
              "justin",
              "client"
            ]
          },
          "due": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        }
      }
    },
    "brain_facts_proposed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact": {
            "type": "string"
          },
          "pillar": {
            "type": "string"
          },
          "quote": {
            "type": "string",
            "description": "The words in the outcomes it comes from"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "accepted",
              "rejected"
            ]
          },
          "brain_fact_id": {
            "type": "string"
          }
        }
      }
    },
    "context_summary": {
      "type": "string",
      "description": "What the agent read for this client (counts), for transparency"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "contact_name": {
      "type": "string",
      "description": "Who the call is with (prospect, investor, partner, or the person at the client)"
    },
    "company": {
      "type": "string",
      "description": "Their company when they are not a CRM client"
    },
    "remember": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Cheat sheet: 3-7 must-not-forget points, a few words each (memory joggers, not a script)"
    },
    "background": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Cheat sheet: where things stand with them right now, from the brain (short bullets)"
    },
    "show": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Things to show on the call (pages, screens, files)"
    },
    "qa": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "asked": {
            "type": "boolean"
          }
        }
      },
      "description": "Questions to ask, with the answer captured during the call"
    },
    "reference_md": {
      "type": "string",
      "description": "Longer prep or background in markdown (written in Claude or pasted). Read by the agent for this call and later calls with the same client"
    },
    "pdfs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "generated",
              "uploaded"
            ]
          },
          "created_at": {
            "type": "string"
          }
        }
      },
      "description": "Saved PDFs of this prep (generated cheat sheets and uploaded files)"
    },
    "source": {
      "type": "string",
      "enum": [
        "app",
        "claude"
      ],
      "default": "app",
      "description": "Where the prep was made"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}