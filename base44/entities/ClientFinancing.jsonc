{
  "name": "ClientFinancing",
  "type": "object",
  "description": "A payment plan for a client: what they bought on terms, the schedule, and every payment received. Short-term (a few installments) or long-term (months/years).",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "CRMClient id"
    },
    "client_name": {
      "type": "string",
      "description": "CRMClient business name at the time (kept so the row reads even if the client is renamed)"
    },
    "title": {
      "type": "string",
      "description": "What is financed, e.g. 'Website build' or 'Command Center app'"
    },
    "kind": {
      "type": "string",
      "enum": [
        "installment",
        "package"
      ],
      "default": "installment",
      "description": "package = the 40-Day Business Rebuild (Nov 25 2026): balance paid monthly on HyperCare+, payoff any time, then $750/mo. installment = any other payment plan."
    },
    "package_plan": {
      "type": "string",
      "enum": [
        "p24",
        "p12"
      ],
      "description": "Package only. p24 = $750/mo x 24 ($18,000). p12 = $1,250/mo x 12 ($15,000)."
    },
    "start_payment": {
      "type": "number",
      "description": "Package only. The start payment ($2,000, or $1,500 when referred). Separate from the balance."
    },
    "referred": {
      "type": "boolean",
      "default": false,
      "description": "Package only. Referred client: $500 off the start payment."
    },
    "start_paid_date": {
      "type": "string",
      "format": "date",
      "description": "Package only. When the start payment was received."
    },
    "launch_date": {
      "type": "string",
      "format": "date",
      "description": "Package only. Website + Command System launch. Monthly payments start here (first_due_date = launch_date)."
    },
    "after_payoff_monthly": {
      "type": "number",
      "default": 750,
      "description": "Package only. HyperCare+ price once the balance is paid off."
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Package only. The Stripe subscription whose paid invoices are applied to this balance automatically."
    },
    "upgrades": {
      "type": "array",
      "description": "Package only. Upgrades over $250 added to the balance; from_installment = first installment (0-based) that carries the new amount.",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "from_installment": {
            "type": "integer"
          }
        }
      }
    },
    "payoff_task_id": {
      "type": "string",
      "description": "Package only. Task created when the balance hit $0 (switch to HyperCare+ $750/mo), so it's made once."
    },
    "term_type": {
      "type": "string",
      "enum": [
        "short",
        "long"
      ],
      "default": "short",
      "description": "short = up to 12 months, long = longer"
    },
    "financed_by": {
      "type": "string",
      "enum": [
        "in_house",
        "third_party"
      ],
      "default": "in_house",
      "description": "in_house = the client pays Interstellar directly; third_party = a lender pays Interstellar and the client repays them"
    },
    "lender": {
      "type": "string",
      "description": "Lender or platform name when third_party (e.g. Affirm, a bank)"
    },
    "total_price": {
      "type": "number",
      "description": "Full price of what was sold"
    },
    "down_payment": {
      "type": "number",
      "default": 0
    },
    "interest_rate": {
      "type": "number",
      "default": 0,
      "description": "APR percent; 0 for interest-free"
    },
    "payment_amount": {
      "type": "number",
      "description": "Amount per installment"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "biweekly",
        "monthly",
        "quarterly"
      ],
      "default": "monthly"
    },
    "num_payments": {
      "type": "integer",
      "description": "Total number of scheduled installments"
    },
    "first_due_date": {
      "type": "string",
      "format": "date"
    },
    "grace_days": {
      "type": "integer",
      "default": 3,
      "description": "Days after a due date before it counts as late"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "paid_off",
        "defaulted",
        "cancelled"
      ],
      "default": "active"
    },
    "payments": {
      "type": "array",
      "description": "Payments received, newest last",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "amount": {
            "type": "number"
          },
          "method": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "stripe_invoice_id": {
            "type": "string",
            "description": "Set when the payment came from a paid Stripe invoice (stops it being counted twice)"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_name",
    "title",
    "payment_amount",
    "num_payments",
    "first_due_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}