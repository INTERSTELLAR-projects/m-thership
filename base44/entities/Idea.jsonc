{
  "name": "Idea",
  "properties": {
    "aiAnalysis": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "plan": {
      "additionalProperties": true,
      "description": "AI Action Plan: verdict, do_first, pareto, phases, ignore, risks, kill_criteria, first_metric, hormozi_angle, resources",
      "type": "object"
    },
    "plan_generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "plan_progress": {
      "additionalProperties": true,
      "description": "Map of plan step key (p{phase}-{step}) to true when checked off",
      "type": "object"
    },
    "project_id": {
      "description": "Project created from this idea's plan",
      "type": "string"
    },
    "status": {
      "default": "New",
      "enum": [
        "New",
        "In Review",
        "Planned",
        "Implemented",
        "Shelved"
      ],
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}