{
  "name": "LaunchClientStatus",
  "description": "Launch Week board: one row per client site in the launch week (unique by slug). Readiness, status summary, what is done and what blocks launch, from the site-audit JSON files, plus the ClaudeJob queued once every blocking LaunchQuestion is answered. Admin only.",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "CRMClient id"
    },
    "client_name": {
      "type": "string"
    },
    "app_id": {
      "type": "string"
    },
    "preview_url": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "launch_readiness_pct": {
      "type": "number"
    },
    "status_summary": {
      "type": "string"
    },
    "done": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocking": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Screenshot URLs (uploaded app assets)"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "imported_at": {
      "type": "string",
      "format": "date-time"
    },
    "job_id": {
      "type": "string",
      "description": "ClaudeJob 'Apply launch answers to <client> site'"
    },
    "job_queued_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "slug",
    "client_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}