{
  "name": "Task",
  "properties": {
    "category": {
      "default": "ops",
      "enum": [
        "design",
        "development",
        "strategy",
        "content",
        "marketing",
        "sales",
        "admin",
        "finance",
        "ops"
      ],
      "type": "string"
    },
    "client_id": {
      "description": "CRMClient id",
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "due_date": {
      "format": "date",
      "type": "string"
    },
    "estimated_days": {
      "default": 0,
      "type": "number"
    },
    "estimated_hours": {
      "default": 0,
      "type": "number"
    },
    "estimated_minutes": {
      "default": 0,
      "description": "Canonical effort estimate",
      "type": "number"
    },
    "is_focus": {
      "default": false,
      "type": "boolean"
    },
    "labels": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "logged_hours": {
      "default": 0,
      "type": "number"
    },
    "logged_seconds": {
      "default": 0,
      "description": "Total timed seconds across every timer run",
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "parent_task_id": {
      "type": "string"
    },
    "portal_visible": {
      "default": false,
      "type": "boolean"
    },
    "priority": {
      "default": 3,
      "type": "number"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "project_type": {
      "description": "Copied from the project so time can be grouped by package",
      "type": "string"
    },
    "recurring_pattern_id": {
      "type": "string"
    },
    "remind_at": {
      "format": "date-time",
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "sop_name": {
      "description": "SOP this step came from",
      "type": "string"
    },
    "sop_step": {
      "description": "Step title inside that SOP, for averaging actuals",
      "type": "string"
    },
    "source": {
      "default": "manual",
      "enum": [
        "manual",
        "voice",
        "ai",
        "sop",
        "request",
        "automation"
      ],
      "type": "string"
    },
    "status": {
      "default": "next",
      "enum": [
        "inbox",
        "next",
        "doing",
        "blocked",
        "done"
      ],
      "type": "string"
    },
    "task_type": {
      "default": "billable",
      "enum": [
        "billable",
        "internal",
        "unpaid",
        "personal"
      ],
      "type": "string"
    },
    "timer_started_at": {
      "description": "Set while a timer is running on this task",
      "format": "date-time",
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "client_action": {
      "default": false,
      "description": "Needs something from the client (shows under 'Needed from you' in their portal when portal_visible)",
      "type": "boolean"
    },
    "client_note": {
      "description": "Client-safe one-liner shown with the to-do in the portal (what we need or what is happening)",
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}