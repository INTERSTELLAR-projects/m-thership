{
  "name": "AdCampaign",
  "type": "object",
  "properties": {
    "account_ref": {
      "type": "string",
      "description": "AdAccount id"
    },
    "platform": {
      "type": "string",
      "description": "Ad platform",
      "enum": [
        "meta",
        "google",
        "tiktok",
        "linkedin"
      ]
    },
    "external_id": {
      "type": "string",
      "description": "Platform campaign id (empty for in-app drafts not yet pushed)"
    },
    "name": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "description": "Our status",
      "enum": [
        "draft",
        "pushed_paused",
        "active",
        "paused",
        "archived",
        "deleted",
        "unknown"
      ],
      "default": "draft"
    },
    "effective_status": {
      "type": "string",
      "description": "Platform effective_status"
    },
    "daily_budget": {
      "type": "number",
      "description": "Major units (e.g. dollars)"
    },
    "lifetime_budget": {
      "type": "number"
    },
    "special_ad_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Meta special_ad_categories (NONE = empty)"
    },
    "origin": {
      "type": "string",
      "enum": [
        "synced",
        "in_app",
        "csv"
      ],
      "default": "synced"
    },
    "draft": {
      "type": "object",
      "additionalProperties": true,
      "description": "In-app draft: { adset: {name,daily_budget,optimization_goal,countries,age_min,age_max,placements}, creative_ids: [], image_ratio }"
    },
    "policy_status": {
      "type": "string",
      "enum": [
        "unchecked",
        "pass",
        "warn",
        "fail"
      ],
      "default": "unchecked"
    },
    "pushed_at": {
      "type": "string",
      "format": "date-time"
    },
    "launched_at": {
      "type": "string",
      "format": "date-time"
    },
    "client_id": {
      "type": "string",
      "description": "CRMClient id when this belongs to a client (future paid portal add-on). Empty = Interstellar's own ads."
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}