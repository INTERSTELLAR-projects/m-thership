{
  "name": "PlanAnalysis",
  "type": "object",
  "properties": {
    "goal_id": {
      "type": "string"
    },
    "target_mrr": {
      "type": "number"
    },
    "mrr_at_run": {
      "type": "number"
    },
    "gap_at_run": {
      "type": "number"
    },
    "computed": {
      "type": "object",
      "additionalProperties": true
    },
    "ai_summary": {
      "type": "object",
      "additionalProperties": true
    },
    "assumptions_snapshot": {
      "type": "object",
      "additionalProperties": true
    },
    "previous_analysis_id": {
      "type": "string"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "manual",
        "mrr_change",
        "scheduled"
      ],
      "default": "manual"
    }
  },
  "required": [
    "goal_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}