{
  "name": "Investment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "estimatedCost": {
      "type": "number"
    },
    "priority": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ],
      "default": "Medium"
    },
    "notes": {
      "type": "string"
    },
    "acquired": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ]
}