{
  "name": "PromptLog",
  "description": "Every request Justin makes (to Claude, the builder or by hand), trimmed. Raw material for PromptPatterns. NEVER secrets, passwords or keys: logPrompt strips anything that looks like one. Admin only.",
  "type": "object",
  "properties": {
    "said_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "claude",
        "base44_builder",
        "manual"
      ],
      "default": "claude"
    },
    "client_id": {
      "type": "string",
      "description": "CRMClient id (blank = Interstellar / all clients)"
    },
    "client_name": {
      "type": "string"
    },
    "app_id": {
      "type": "string"
    },
    "area_id": {
      "type": "string",
      "description": "PlaybookArea id"
    },
    "phase": {
      "type": "string",
      "enum": [
        "build",
        "tweak",
        "polish",
        "launch",
        "maintain"
      ],
      "default": "tweak"
    },
    "text": {
      "type": "string",
      "description": "His words, trimmed"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pattern_id": {
      "type": "string",
      "description": "PromptPattern id once clustered"
    },
    "clustered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
