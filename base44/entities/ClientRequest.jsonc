{
  "name": "ClientRequest",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "CRMClient id"
    },
    "client_name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "site_edit",
        "project_submission",
        "job",
        "new_page",
        "question",
        "app_edit",
        "other"
      ],
      "default": "site_edit"
    },
    "title": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": true
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "in_progress",
        "needs_info",
        "complete",
        "declined"
      ],
      "default": "received"
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "urgent"
      ],
      "default": "normal"
    },
    "submitted_by": {
      "type": "string"
    },
    "page_status": {
      "type": "string",
      "enum": [
        "none",
        "queued",
        "generating",
        "live",
        "failed"
      ],
      "default": "none"
    },
    "page_url": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "admin_notes": {
      "type": "string"
    },
    "client_note": {
      "type": "string",
      "description": "Shown to the client when status changes"
    },
    "form_id": {
      "type": "string",
      "description": "RequestForm used for this submission"
    },
    "form_title": {
      "type": "string"
    },
    "answers": {
      "type": "array",
      "description": "Readable copy of the submission: [{label, value}] in form order (what Claude reads)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "value": {}
        }
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "portal",
        "public_form",
        "client_app",
        "admin"
      ],
      "default": "portal"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}