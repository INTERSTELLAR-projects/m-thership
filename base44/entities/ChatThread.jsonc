{
  "name": "ChatThread",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "group",
        "direct"
      ],
      "default": "group",
      "description": "group = several clients + Interstellar. 1:1 chats need no record (they are keyed by ConversationMessage.client_id)."
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "client_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Member CRMClient ids. Never sent to portal users."
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_message_preview": {
      "type": "string"
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}