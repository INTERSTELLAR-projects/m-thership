{
  "name": "LegalItem",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "enum": [
        "deadline",
        "todo",
        "date"
      ]
    },
    "task": {
      "type": "string"
    },
    "dueDate": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "Upcoming"
    },
    "done": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "section"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}