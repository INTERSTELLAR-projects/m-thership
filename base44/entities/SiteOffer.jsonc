{
  "name": "SiteOffer",
  "description": "Self-serve offers (Build Engine, Nov 19 2026): the client enters what, % or $ off and dates in the portal; the website shows it while it runs. The matching checkout discount (Stripe coupon / Shopify code, ending on its own) is a HARD GATE: discount_status awaiting_approval waits for Justin's one tap (approved); only then may the queue runner create it. Never created automatically.",
  "type": "object",
  "properties": {
    "client_id": { "type": "string" },
    "client_name": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "kind": { "type": "string", "enum": ["percent", "amount"], "default": "percent" },
    "value": { "type": "number" },
    "starts_on": { "type": "string", "format": "date" },
    "ends_on": { "type": "string", "format": "date" },
    "status": { "type": "string", "enum": ["live", "ended"], "default": "live", "description": "live = shown on the site between its dates; ended = the client or Justin ended it early" },
    "discount_provider": { "type": "string", "enum": ["", "stripe", "shopify", "none"], "default": "" },
    "discount_status": { "type": "string", "enum": ["none", "awaiting_approval", "approved", "created", "declined", "failed"], "default": "awaiting_approval" },
    "discount_code": { "type": "string" },
    "discount_ref": { "type": "string", "description": "Stripe coupon / Shopify price rule id once created" },
    "approved_by": { "type": "string" },
    "approved_at": { "type": "string", "format": "date-time" },
    "discount_error": { "type": "string" },
    "created_by": { "type": "string" }
  },
  "required": ["client_id", "title"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
