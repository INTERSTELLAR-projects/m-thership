{
  "name": "RecurringPattern",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "design",
        "development",
        "strategy",
        "content",
        "marketing",
        "sales",
        "admin",
        "finance",
        "ops"
      ],
      "default": "ops"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "billable",
        "internal",
        "unpaid",
        "personal"
      ],
      "default": "billable"
    },
    "priority": {
      "type": "number",
      "default": 3
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "CRMClient id"
    },
    "client_name": {
      "type": "string"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cadence_days": {
      "type": "number",
      "default": 7
    },
    "occurrences": {
      "type": "number",
      "default": 0
    },
    "last_seen_date": {
      "type": "string",
      "format": "date"
    },
    "last_created_date": {
      "type": "string",
      "format": "date"
    },
    "next_due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "suggested",
        "enabled",
        "paused"
      ],
      "default": "suggested"
    },
    "sample_titles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "signature"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}