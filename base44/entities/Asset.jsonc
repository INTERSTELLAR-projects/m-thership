{
  "name": "Asset",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "profile_photo",
        "logo",
        "custom_icon"
      ],
      "default": "profile_photo"
    },
    "file_url": {
      "type": "string",
      "description": "Public permanent URL of the uploaded image"
    }
  },
  "required": [
    "type",
    "file_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}