{
  "name": "ToDoItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "taskType": {
      "type": "string",
      "enum": [
        "F\u00f8rge Development",
        "GBP Update",
        "Presentation",
        "New Website Build",
        "New App Build",
        "Website Update",
        "Internal Tasks",
        "Other Task"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "Priority",
        "NextUp"
      ],
      "default": "Priority"
    },
    "dueDate": {
      "type": "string"
    },
    "estimatedAmount": {
      "type": "number"
    },
    "estimatedUnit": {
      "type": "string",
      "enum": [
        "Minutes",
        "Hours",
        "Days",
        "Weeks",
        "Months"
      ]
    },
    "actualAmount": {
      "type": "number"
    },
    "actualUnit": {
      "type": "string",
      "enum": [
        "Minutes",
        "Hours",
        "Days",
        "Weeks",
        "Months"
      ]
    },
    "completedDate": {
      "type": "string"
    },
    "assignedTo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "In Progress",
        "Completed"
      ],
      "default": "Pending"
    },
    "done": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "category"
  ]
}