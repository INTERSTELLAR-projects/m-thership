{
  "name": "ToDoItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "taskType": {
      "type": "string",
      "enum": [
        "Førge Development",
        "GBP Update",
        "Presentation",
        "New Website Build",
        "New App Build",
        "Website Update",
        "Internal Tasks",
        "Other Task"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "Priority",
        "NextUp"
      ],
      "default": "Priority"
    },
    "dueDate": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "estimatedAmount": {
      "type": "number",
      "default": 0
    },
    "estimatedUnit": {
      "type": "string",
      "enum": [
        "Minutes",
        "Hours",
        "Days",
        "Weeks",
        "Months"
      ]
    },
    "actualAmount": {
      "type": "number"
    },
    "actualUnit": {
      "type": "string",
      "enum": [
        "Minutes",
        "Hours",
        "Days",
        "Weeks",
        "Months"
      ]
    },
    "completedDate": {
      "type": "string"
    },
    "assignedTo": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "In Progress",
        "Completed"
      ],
      "default": "Pending"
    },
    "done": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}