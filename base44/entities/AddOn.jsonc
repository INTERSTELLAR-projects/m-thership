{
  "name": "AddOn",
  "description": "Upgrade Store catalog: add-on features Justin sells into client portals and client apps (try, then buy). Admin-only; clients read it through the `addons` function. Prices are Justin's decision; an add-on only gates a client app once status is live.",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Permanent id used by client apps (e.g. dreamscape_3d)"
    },
    "name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "What it does, shown on the detail view (plain text, blank lines = paragraphs)"
    },
    "category": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "lucide icon name (optional)"
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "media": {
      "type": "array",
      "description": "[{ type: image|video, url, caption }]",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "price_model": {
      "type": "string",
      "enum": [
        "one_time",
        "monthly",
        "both"
      ],
      "default": "one_time",
      "description": "both = one-time setup + monthly license in one subscription checkout"
    },
    "price_one_time": {
      "type": "number",
      "description": "USD. Empty = not priced yet"
    },
    "price_monthly": {
      "type": "number",
      "description": "USD per month. Empty = not priced yet"
    },
    "payment_link_one_time": {
      "type": "string",
      "description": "Optional Stripe Payment Link override for the one-time plan"
    },
    "payment_link_monthly": {
      "type": "string",
      "description": "Optional Stripe Payment Link override for monthly / setup + monthly"
    },
    "pricing_note": {
      "type": "string",
      "description": "Internal note about pricing (never shown to clients)"
    },
    "trial_mode": {
      "type": "string",
      "enum": [
        "none",
        "one_use",
        "days",
        "uses"
      ],
      "default": "one_use"
    },
    "trial_days": {
      "type": "number"
    },
    "trial_uses": {
      "type": "number"
    },
    "availability": {
      "type": "string",
      "enum": [
        "all",
        "selected",
        "industries"
      ],
      "default": "selected"
    },
    "client_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "industries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Matched as words inside CRMClient.industry"
    },
    "delivery_type": {
      "type": "string",
      "enum": [
        "feature_flag",
        "external_url",
        "provisioning_task"
      ],
      "default": "external_url"
    },
    "feature_flag": {
      "type": "string"
    },
    "external_url": {
      "type": "string"
    },
    "provisioning_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "live",
        "retired"
      ],
      "default": "draft"
    },
    "launched_at": {
      "type": "string",
      "format": "date-time"
    },
    "sort_order": {
      "type": "number",
      "default": 100
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    }
  },
  "required": [
    "key",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}